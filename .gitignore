# LibreOffice / Excel lock files
.~lock.*#
~$*

# The spreadsheet era - kept on disk as a draft-day backup, not published to the web
*.xlsx
*.gs

# OS noise
.DS_Store
Thumbs.db

# Never re-commit the innards of a .git folder as if they were website files
/objects/
/refs/
/hooks/
/logs/
/info/
/branches/
/HEAD
/ORIG_HEAD
/COMMIT_EDITMSG
/config
/description
/index

# test deps
test/node_modules/

# raw Sleeper payloads - refetched by the pipeline, no need to version them
pipeline/sleeper_*.json
pipeline/board.json

# python bytecode
__pycache__/
*.pyc

# jsdom is symlinked in from a sandbox path just to run the tests
test/node_modules

# One-off probes written while chasing a specific bug. They are scratch paper: they hard-code
# a seed or a roster, they are not run by smoke.mjs, and half of them stop working the moment
# the thing they were probing is fixed. Leaving them untracked kept the commit dialog full of
# files nobody meant to publish.
test/_*.mjs
test/tmp/
